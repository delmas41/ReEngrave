# Phase C alignment manifest is a transient script output, large, and only
# meaningful once the OMR bugs from PHASE_C_FINDINGS.md are fixed. The reference
# overlay PNG IS committed (it illustrates the findings doc).
phase-c-output/*.json

# Phase E intermediate debug artifacts. The catalog-ready movements.yaml files
# get committed under tools/omr/training/data/imslp/; the contact sheets,
# candidate strips, per-cell label .txt files, and overlay PNGs are
# regeneratable from the scripts + source PDFs and would bloat the repo.
phase-e-output/
phase-e-labels/

# Phase G batch run output — large catalog-wide label set, regeneratable.
# Keep the run summary JSON only.
phase-g-output/*
!phase-g-output/batch_summary.json
!phase-g-output/.gitkeep

# Phase H training-prep artifacts. Rendered images + labels + train.txt
# regenerate from phase_h_render_pages.py + phase_h_build_splits.py.
# The bundle.tar.gz is the scp payload; not source-of-truth.
phase-h-data/
phase-h-bundle.tar.gz
prod_names.tsv

# Phase I visual validation outputs. Large PNG overlays regenerable from
# phase_i_overlay_compare.py + phase_i_zoom_check.py against the catalog
# PDFs; not source-of-truth.
phase-i-overlay/

# Phase J structural-only label set + batch output. Same shape as Phase
# E/G — large auto-generated artifacts, regenerable from phase_j_emit_labels.py.
phase-j-labels/
phase-j-output/*
!phase-j-output/batch_summary.json
!phase-j-output/.gitkeep
