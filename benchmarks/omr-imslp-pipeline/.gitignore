# Phase C alignment manifest is a transient script output, large, and only
# meaningful once the OMR bugs from PHASE_C_FINDINGS.md are fixed. The reference
# overlay PNG IS committed (it illustrates the findings doc).
phase-c-output/*.json

# Phase E intermediate debug artifacts. The catalog-ready movements.yaml files
# get committed under tools/omr/training/data/imslp/; the contact sheets,
# candidate strips, per-cell label .txt files, and overlay PNGs are
# regeneratable from the scripts + source PDFs and would bloat the repo.
phase-e-output/
phase-e-labels/

# Phase G batch run output — large catalog-wide label set, regeneratable.
# Keep the run summary JSON only.
phase-g-output/*
!phase-g-output/batch_summary.json
!phase-g-output/.gitkeep
