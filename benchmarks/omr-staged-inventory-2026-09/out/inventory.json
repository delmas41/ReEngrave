  "consequences": [
    {
      "consequence": "restate_pitch",
      "cause": "clef",
      "effect": "pitch",
      "scope": "staff",
      "stub": false,
      "bound": "One pitch per notehead that already has a POSITION row. Adds no notehead, deletes none, and re-reads no geometry. A staff whose clef ABSTAINED produces no pitches at all -- it does not fall back to treble."
    },
    {
      "consequence": "size_measure_rest",
      "cause": "meter",
      "effect": "duration",
      "scope": "cell",
      "stub": false,
      "bound": "Fires only on a bar whose ONLY standing duration is ONE rest, whose glyph is `restWhole`, with no dots, and only where the meter is DECIDED. Rewrites that one duration to the bar's length and marks it. Adds no event, deletes none, and touches no bar holding anything else."
    },
    {
      "consequence": "reconcile_duration",
      "cause": "meter",
      "effect": "duration",
      "scope": "cell",
      "stub": false,
      "bound": "Searches only the levels a note ADMITS -- its own narrowed candidates, or +/-1 for a note that decided. Changes at most ONE note. The corrected bar must land EXACTLY on the meter. The answer must be UNIQUE. Never adds, deletes or re-pitches a note. Tuplet members are excluded -- re-deriving a level would silently drop the ratio."
    },
    {
      "consequence": "move_glyph",
      "cause": "glyph_owner",
      "effect": "pitch",
      "scope": "glyph",
      "stub": false,
      "bound": "Restates one glyph's pitch against the staff that won it. Emits no detection and destroys none -- a losing copy is SUPERSEDED, not deleted, so the contest stays on the record."
    },
    {
      "consequence": "respell_accidental",
      "cause": "key_signature",
      "effect": "accidental",
      "scope": "staff",
      "stub": false,
      "bound": "Re-spells the LETTER of an existing pitch only. Never changes a staff position, never adds or removes a note, and NEVER re-derives the key from the new spelling -- which is what keeps the edge downhill."
    },
    {
      "consequence": "name_part",
      "cause": "instrument",
      "effect": "part_name",
      "scope": "staff",
      "stub": false,
      "bound": "Writes a name onto a staff. Changes no note, no clef and no structure."
    },
    {
      "consequence": "join_parts",
      "cause": "part_partition",
      "effect": "part_name",
      "scope": "document",
      "stub": true,
      "bound": "Decides which staves are the same part. Emits no music and moves no note between staves."
    }
  ],
