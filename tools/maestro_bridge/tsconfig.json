{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": false,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": false,
    "noEmit": true,
    "isolatedModules": true
  },
  "include": ["analyze.ts", "gradus/lib/**/*.ts"],
  "exclude": ["gradus/node_modules", "gradus/.next", "gradus/app", "gradus/components", "gradus/__tests__", "gradus/e2e", "gradus/evals"]
}
