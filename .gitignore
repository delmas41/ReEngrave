# Environment / secrets — never commit these
.env
.env.local
.env.*.local
.env.production
backend/.env.production

# Database
*.db
*.db-shm
*.db-wal

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
dist/
build/
.pytest_cache/

# Node / frontend
node_modules/
frontend/dist/
frontend/.vite/

# Uploads / exports (runtime data)
uploads/
exports/
backend/uploads/
backend/exports/

# ML model weights (kept locally, never committed — large binary blobs)
omr-weights
*.pt
*.pth
*.onnx
*.safetensors

# OS
.DS_Store
Thumbs.db

# Claude worktrees
.claude/worktrees/

# Editor / IDE
.idea/
.vscode/
*.swp

# OMR pipeline artifacts
# YOLO weights — large binaries, downloaded by ultralytics on demand
*.pt
*.pth
*.onnx
*.safetensors
yolov8m.pt
# Trained model directories from ultralytics
runs/
# DeepScoresV2 dataset (downloaded; many GB)
# No trailing slash: with one this matches only a DIRECTORY, and a symlink
# left at this path (to reach the dataset from a git worktree) is not a
# directory — so `git add -A` tracked it, and merging that into the main
# checkout replaced the real dataset with a symlink to itself.
tools/omr/training/data
# Shared OMR weights directory mounted into the backend container
# (lives at repo root so all worktrees can share one weights file)
# No trailing slash, for the same reason as tools/omr/training/data above: a
# worktree reaches the weights through a SYMLINK at this path, and a symlink is
# not a directory, so a pattern ending in / does not match it.
omr-weights

# Rendered PNG outputs from benchmark runs — reproducible from PDFs
# Keep verdicts, detection JSONs, reports, CSVs — exclude the heavy renders.
benchmarks/*/cells/
# Rendered orchestral fixtures: mechanically regenerated from the Gradus MXLs
# by tools.omr.training.orchestral_eval. No human work in them, unlike the
# labeled cells above. The dossiers under data/dossiers/ ARE committed, since
# they depend on an external checkout that may move.
benchmarks/omr-orchestral-e2e/fixtures/
# ...and any alternate --work-dir. `orchestral_eval --work-dir` takes an
# arbitrary path, and a measurement that compares two configurations needs two
# of them, so the convention is `fixtures-<what>`. Added 2026-09-02 after
# `git add -A benchmarks/` swept a `fixtures-dirtext` of rendered PDFs and
# LilyPond into a commit — the pattern above only ever covered the one name.
benchmarks/omr-orchestral-e2e/fixtures-*/
benchmarks/omr-end-to-end/fixtures/
benchmarks/omr-corpus-widening-2026-09/fixtures/
benchmarks/*/overlays/
benchmarks/omr-phase1/*.png
benchmarks/omr-phase1/*-cells/
benchmarks/omr-phase1/*-nostaff/
benchmarks/omr-phase1/*/page*.png
benchmarks/omr-phase1/*-overlay.png
benchmarks/omr-phase2/wtc-p5/
benchmarks/omr-phase2/wtc-p5-*/
benchmarks/omr-phase3/verdicts-yolo/

# Stale / superseded benchmark outputs — old experiments preserved only
# in commit history. Keep canonical `detections/`, `verdicts/`, `overlays/`
# (when small) plus reports. Anything with these suffixes is throwaway.
benchmarks/**/*-aborted/
benchmarks/**/*-backup/
benchmarks/**/*-old/
benchmarks/**/overlays-*/

# Adjudication crop / overlay PNGs — rendered from the source PDFs on demand
# (system-grouping benchmark, Sep 2026). Keep the markdown, scripts, jsonl and
# ground truth; the crops are heavy (~180 MB) and reproducible.
benchmarks/**/crops/
benchmarks/omr-system-grouping-2026-09/pilot/*.png
# Page-context thumbnails for the labeling UI — rendered from PDFs on demand
benchmarks/*/page-thumbnails/
# LilyPond output for the clef corpora — the .ly files are the source, and
# `lilypond` rebuilds these in a second (see check_clef_precision.py).
benchmarks/omr-clef-geometry/*.pdf
benchmarks/omr-clef-geometry/*.ps
# LilyPond embeds a creation/modify timestamp in every PDF's XMP metadata,
# so tools.omr.acceptance's compiled PDF differs byte-for-byte on every run
# even when the music is identical — the .ly source (deterministic) and
# current.json's compiled/pdf_produced/barcheck_failures fields are what's
# tracked; the PDF is a second's rebuild away (`lilypond -o <dir> <ly>`).
benchmarks/acceptance/out/**/*.pdf

# ⚠️ A GATHER'S OWN RECORD IS NOT COMMITTABLE AND `out/` IS NOT IGNORED.
# `gather_movement.sh` writes its record beside the derived artefacts, and
# `benchmarks/acceptance/out/` is deliberately NOT gitignored -- the clean-tree
# guard exempts it by path precisely because it is tracked territory holding
# untracked build products. A whole-movement record is 300-500 MB, over
# GitHub's 100 MB file limit, and the established pattern (6fbd46ed) keeps the
# record in `library/_shared-records/` (gitignored, machine-local, with an md5
# receipt in the manifest) and commits only what is DERIVED from it: the
# MusicXML, the LilyPond, the coverage report and the log.
# Learned the hard way on 2026-09-23: `git add -A benchmarks/acceptance` swept
# a 456 MB record in and the push was rejected by the remote.
benchmarks/acceptance/out/**/*.record.json
benchmarks/acceptance/out/**/*.record.json.md5

# Transcribe output kept beside a benchmark run. Regenerable from the PDF and
# the weights, and enormous: eleven of these reached main in the 2026-08-28
# clef/key-signature merge and cost 30 MB between them — a single Mahler page
# is 135k lines of JSON. Commit the REPORT that cites the numbers, not the dump
# it read them from; if a specific run has to be pinned as evidence, add it by
# path with `git add -f` and say in the commit message why this one is worth it.
#
# Note this does not untrack the eleven already in history — .gitignore never
# applies to files git is already tracking. It stops the next ones.
benchmarks/**/*.omr.json

# Pre-cleanup label backups — scratch copies; the cleaned labels + the
# verdicts_pre_* snapshots in benchmarks/ are the durable record
data/user-labeled/*/labels_pre_cleanup/

# ultralytics label caches (written next to labels/ during training)
labels.cache

# musicdiff/OMR-NED lives in its own venv (needs Python >= 3.10; host is 3.9).
# No trailing slash: a git worktree reaches the venv by symlinking the main
# checkout's, and a trailing slash matches directories only — so the symlink was
# offered for commit, pointing at an absolute path outside the repository.
.venv-omrned

# Surya 2 margin-label reader (Python >= 3.10 + llama.cpp)
.venv-surya

# Central score library — the PDF/MusicXML store is machine-local (650 MB).
# Its catalog (data/score-library/catalog.json) IS committed; see that README.
# Anchored: an unanchored "library/" also swallows tools/library, the code.
# ⚠️ NO TRAILING SLASH. `/library/` matches a DIRECTORY only, and a worktree
# reaches the store through a SYMLINK to the main checkout's `library` — which
# that pattern does not match, so `git add -A` committed the symlink (a
# machine-local absolute path) into a benchmark commit on 2026-09-09. `/library`
# matches both and is still anchored, so `tools/library` is untouched.
/library

# Rehearsal/distillation label roots are BUILD PRODUCTS of
# benchmarks/omr-labeling-survey-2026-09/build_rehearsal_versions.py — they copy
# every image out of data/user-labeled/ and are regenerated from the committed
# verdicts, the committed teacher checkpoint and the committed builder. The
# report JSON beside the builder is what carries the provenance.
data/user-labeled-rehearsal/
data/user-labeled-distill/

# Specialist training roots are build products of
# benchmarks/omr-labeling-survey-2026-09/build_specialist_versions.py — they
# carve per-symbol corpora out of data/user-labeled/ and are regenerated from
# the committed verdicts, pass configs and builder. specialist.json beside each
# one carries the provenance.
data/specialist-*/

# merge_additions.py backups — build products, not evidence
benchmarks/omr-scan-e2e-2026-09/works.json.bak-*

# mutation-battery scratch — the BYTE snapshot and in-flight sentinel a battery
# writes to disk so an interrupted run can be detected and the tree restored.
# Never evidence; a committed one would look like a live interruption.
benchmarks/**/.mutate-*

# the plumbing matrix writes 140+ records here; ignoring them keeps the
# tree clean so `provenance.dirty` on each record means something
benchmarks/omr-plumbing-2026-09/out/

# staged records are 100+ MB build products, not source
benchmarks/omr-positional-store-2026-09/out/*.record.json

# ROADMAP 2.11 base-vs-arm gather records: a one-page staged record on the
# Litolff count page is ~100 MB and is regenerated by the two commands in
# benchmarks/omr-clef-geometry-2026-09/FINDINGS.md. The derived JSON beside
# them (occupied-reach-*.json, the before/after tables) and the print crops
# under out/print/ ARE tracked -- `out/print/` is deliberately not `crops/`,
# which the rule above excludes.
benchmarks/omr-clef-geometry-2026-09/out/*.record.json
benchmarks/omr-clef-geometry-2026-09/out/*.musicxml
